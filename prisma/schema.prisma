// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int     @id @default(autoincrement())
  studentId        String  @unique
  name             String?
  email            String?
  facultyId        String?
  departmentId     String?
  role             String  @default("student")
  passwordHash     String?
  gender           String?
  major            String?
  titleName        String?
  subKeyId         String?
  subMajorId       String?
  subMajorNameThai String?
  year             String?
  yearStatus       String?

  isVoted         Boolean   @default(false)
  votedAt         DateTime? // when THIS voter cast their ballot — their own
  //                          non-secret data (drives the success receipt). No
  //                          link to a Ballot row: which party they chose lives
  //                          only inside the encrypted, unlinkable Ballot (v2-SEC).
  isFormCompleted Boolean   @default(false)
  createdAt       DateTime  @default(now())
  isAdmin         Boolean   @default(false)

  authoredTemplates Template[] @relation("AuthoredTemplates")
}

model Member {
  id        Int    @id @default(autoincrement())
  studentId String @unique
  name      String
  number    Int    @default(0)

  imageUrl      String
  modalImageUrl String?

  major    String?
  position String?

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

model Candidate {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  number  Int     @unique
  slogan  String?
  logoUrl String?
  color   String? // party identity colour (hex, e.g. "#7FC8FF"); admin-set, optional

  groupImageUrls   Json?
  officialImageUrl String?
  mobileHeroImage  Json?

  logoMeaning String?
  missions    Json?
  policies    Json?

  members Member[]

  score Int @default(0)

  // ช่องทางติดต่อของพรรค — {instagram, facebook, tiktok, website} เก็บเป็น Json
  // ก้อนเดียวโดยตั้งใจ: ปีหน้าถ้าอยากเพิ่มช่องทางใหม่จะได้ไม่ต้อง migrate อีกรอบ
  // ค่าที่เก็บเป็น URL เต็มที่ผ่านการตรวจแล้วเสมอ (utils/socialLinks.js)
  socials Json?
}

// ============================================================
// v2-SEC — anonymous, encrypted, tamper-evident ballot box (LOCKED "B+" 60e0de2)
// ============================================================
//
// A Ballot carries NO userId and NO fine timestamp — it is structurally
// unlinkable to the voter who cast it. `payload` is RSA-OAEP ciphertext of
// {c: candidateId, n: nonce} under the election PUBLIC key; the private key
// never exists on the server (dispute-only, offline). The tally the results
// API serves is still Candidate.score (atomic increment) — losing the private
// key loses only dispute-recount, never the election result.
//
// Every row is HMAC-chained (prevHash → rowHash) so a silent edit to any past
// ballot breaks the chain and is detectable (scripts/verify-ballot-chain.js).
// App DB role is INSERT-only on this table (scripts/sql/ballot-grants.sql) so
// the app itself structurally cannot rewrite a cast ballot.
model Ballot {
  seq        Int    @id @default(autoincrement()) // chain order (residual risk accepted)
  payload    String // base64 RSA-OAEP(sha256) of JSON {c: candidateId, n: nonce}
  hourBucket String? // coarse "2569-02-06T09" at most — never a fine timestamp
  prevHash   String // rowHash of seq-1 (genesis = "GENESIS")
  rowHash    String // HMAC-SHA256(BALLOT_CHAIN_SECRET, prevHash|payload|seq)
}

// Single-row (id=1) tip of the ballot chain. The `UPDATE ... WHERE id=1` inside
// the vote transaction takes a Postgres row lock that SERIALIZES concurrent
// votes — this is what guarantees two simultaneous ballots still produce a
// verifiable, gap-free chain. Seeded with head="GENESIS", seq=0.
model ChainHead {
  id   Int    @id @default(1)
  head String @default("GENESIS")
  seq  Int    @default(0)
}

// Append-only trail of admin actions (mode changes, reset, anonymize, etc.) for
// election-integrity accountability — who did what, when. Written by the admin
// dashboard route; never updated/deleted by the app.
model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  detail    String?
  actor     String?  // admin studentId (or id) from the verified session/cookie
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SystemConfig {
  id            Int      @id @default(1)
  isVoteOpen    Boolean  @default(false) // legacy — ไม่ถูกใช้ gating แล้ว (ADM-3); รอถอดตอน annual reset
  showResult    Boolean  @default(false)
  systemMode    String   @default("AUTO")
  googleFormUrl String?
  pageLayout    Json?
  themeConfig   Json?
  globalConfig  Json?
  updatedAt     DateTime @updatedAt

  activeTemplateId String? @default("classic")

  // Shared admin password — bcrypt hash, one for the whole committee.
  // Identity comes from the studentId typed at login + User.isAdmin; this hash
  // only proves "I was given the committee password". Written by
  // scripts/admin.js --rotate-password; the plaintext is never stored anywhere.
  adminPasswordHash String?
}

// ============================================================
// Template System (Phase 3) — added 2026-05-19
// ============================================================

model Template {
  id String @id @default(cuid())

  slug        String  @unique
  name        String
  description String?

  authorId Int?
  author   User? @relation("AuthoredTemplates", fields: [authorId], references: [id])

  isBuiltIn  Boolean @default(false)
  isLocked   Boolean @default(false)
  forkedFrom String?
  visibility String  @default("private")

  pages    Json
  elements Json
  theme    Json

  schemaVersion String  @default("v1")
  archivedYear  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([isBuiltIn])
  @@index([isLocked])
  @@index([forkedFrom])
}
